# --- Data: ignore everything under data/ except .gitkeep files and split lists ---
data/**
!data/
!data/**/
!data/**/.gitkeep
!data/splits/
!data/splits/*.txt

# --- Models / weights ---
models/**
!models/
!models/.gitkeep

# --- Docker volumes (Postgres, Label Studio) and local secrets ---
volumes/
.env

# --- Safety net: images, masks, arrays and checkpoints are never committed,
#     wherever they are. Add explicit exceptions only when a real need appears. ---
*.jpg
*.jpeg
*.png
*.webp
*.tif
*.tiff
*.heic
*.npy
*.pt
*.pth

# Uppercase variants (git ignore patterns are case-sensitive on case-sensitive filesystems)
*.JPG
*.JPEG
*.PNG
*.HEIC
*.WEBP
*.TIF
*.TIFF

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Notebooks (outputs are stripped with nbstripout, see CLAUDE.md) ---
.ipynb_checkpoints/

# --- Handoff notes for the project coordinator: never committed ---
.handoff/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
